{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.0.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://x.com/*"
  ],
  "action": {
    "default_icon": "assets/logo.png"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": [
        "scripts/settings.js",
        "scripts/content.js",
        "scripts/extractor.js",
        "scripts/injector.js",
        "scripts/storage.js"
      ],
      "css": ["styles/styles.css"]
    }
  ],
  "background": {
    "service_worker": "scripts/background.js"
  }
}
